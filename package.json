{
  "name": "chemomer",
  "version": "0.1.1",
  "description": "Native Rust InChI engine for Node — molfile in, identifier / AuxInfo / InChIKey out (the napi binding, feature `napi`)",
  "keywords": [
    "inchi",
    "inchikey",
    "chemistry",
    "cheminformatics",
    "napi-rs"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chemomer/chemomer.git"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "chemomer*.node"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release --features napi --js index.js --dts index.d.ts",
    "build:debug": "napi build --platform --features napi --js index.js --dts index.d.ts",
    "prepublishOnly": "napi prepublish --tagstyle none --skip-gh-release",
    "test": "npm run build:debug && node scripts/smoke-napi.mjs"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4"
  },
  "napi": {
    "binaryName": "chemomer"
  },
  "optionalDependencies": {
    "chemomer-win32-x64-msvc": "0.1.1",
    "chemomer-darwin-x64": "0.1.1",
    "chemomer-linux-x64-gnu": "0.1.1"
  }
}
